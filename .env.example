# Public URL of the site, used for metadata, the sitemap, JSON-LD and Open Graph.
NEXT_PUBLIC_SITE_URL=https://yourname.dev

# Optional. Where POST /api/hello forwards messages (Slack, Discord, Zapier and
# similar accept a JSON POST). Without it the endpoint answers 503 and points
# people to your email address.
CONTACT_WEBHOOK_URL=

# The footer shows the deployed commit. Vercel sets VERCEL_GIT_COMMIT_SHA and
# GitHub Actions sets GITHUB_SHA; elsewhere set COMMIT_SHA, or it falls back to
# `git rev-parse --short HEAD` at build time.
# COMMIT_SHA=
